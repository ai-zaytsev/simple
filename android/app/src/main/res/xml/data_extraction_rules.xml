<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device through a backup. Session state and any future
    credential must not travel through a cloud backup or a device transfer.
    See docs/architecture/secrets-model.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
