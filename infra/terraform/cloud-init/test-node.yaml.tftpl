#cloud-config
# Verification node bring-up.
#
# The node receives its whole configuration here and is never touched by hand.
# It writes no access log: an access log records every destination, which is the
# browsing history the privacy model forbids. That rule applies to a node that
# lives for ten minutes exactly as it applies to production.

package_update: true
packages:
  - curl
  - unzip
  - ca-certificates

write_files:
  - path: /etc/xray-install.sh
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      version="${xray_version}"
      workdir=$(mktemp -d)
      cd "$workdir"

      base="https://github.com/XTLS/Xray-core/releases/download/$version"
      curl -fsSL -o xray.zip "$base/Xray-linux-64.zip"
      curl -fsSL -o xray.zip.dgst "$base/Xray-linux-64.zip.dgst"

      # The release is verified against the digest published beside it. This is
      # weaker than an independent signature, but it does catch a corrupted or
      # truncated download, and it is what the upstream project publishes.
      expected=$(grep -i 'SHA2-256=' xray.zip.dgst | head -1 | cut -d'=' -f2 | tr -d '[:space:]')
      actual=$(sha256sum xray.zip | cut -d' ' -f1)
      if [ -n "$expected" ] && [ "$expected" != "$actual" ]; then
        echo "checksum mismatch: expected $expected got $actual" >&2
        exit 1
      fi

      unzip -o xray.zip -d /usr/local/bin xray
      chmod 0755 /usr/local/bin/xray
      /usr/local/bin/xray version

  - path: /usr/local/etc/xray/config.json
    permissions: "0600"
    content: |
      {
        "log": { "access": "none", "loglevel": "warning" },
        "inbounds": [
          {
            "tag": "vless-reality",
            "listen": "0.0.0.0",
            "port": 443,
            "protocol": "vless",
            "settings": {
              "clients": [
                { "id": "${uuid}", "flow": "xtls-rprx-vision" }
              ],
              "decryption": "none"
            },
            "streamSettings": {
              "network": "tcp",
              "security": "reality",
              "realitySettings": {
                "show": false,
                "dest": "${dest}",
                "xver": 0,
                "serverNames": ["${server_name}"],
                "privateKey": "${private_key}",
                "shortIds": ["${short_id}"]
              }
            },
            "sniffing": { "enabled": false }
          }
        ],
        "outbounds": [
          { "tag": "direct", "protocol": "freedom" }
        ]
      }

  - path: /etc/systemd/system/xray.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Xray verification node
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      ExecStart=/usr/local/bin/xray run -config /usr/local/etc/xray/config.json
      Restart=on-failure
      RestartSec=3
      NoNewPrivileges=true
      LimitNOFILE=65536

      [Install]
      WantedBy=multi-user.target

runcmd:
  - /etc/xray-install.sh
  - systemctl daemon-reload
  - systemctl enable --now xray
  # A marker the workflow polls for. Without it the workflow would have to
  # guess when the node is ready, and a guess produces flaky verification.
  - sh -c 'sleep 2; systemctl is-active xray > /var/lib/xray-ready || true'
