#cloud-config

package_update: true
package_upgrade: false

packages:
  - nginx
  - certbot
  - python3-certbot-nginx

ssh_pwauth: false

write_files:
  - path: /etc/ssh/sshd_config.d/99-simple-vpn-site.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password

  - path: /var/www/simple-vpn/index.html
    owner: root:www-data
    permissions: "0644"
    encoding: b64
    content: ${index_html_b64}

  - path: /var/www/simple-vpn/404.html
    owner: root:www-data
    permissions: "0644"
    encoding: b64
    content: ${notfound_html_b64}

  - path: /var/www/simple-vpn/styles.css
    owner: root:www-data
    permissions: "0644"
    encoding: b64
    content: ${styles_css_b64}

  - path: /var/www/simple-vpn/app.js
    owner: root:www-data
    permissions: "0644"
    encoding: b64
    content: ${app_js_b64}

  - path: /etc/nginx/sites-available/simple-vpn
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${nginx_conf_b64}

  - path: /usr/local/sbin/ensure-simple-vpn-certificate
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      domain="simple-vpn.download"
      if [ -s "/etc/letsencrypt/live/$domain/fullchain.pem" ]; then
        exit 0
      fi
      certbot --nginx --non-interactive --agree-tos \
        --register-unsafely-without-email --redirect -d "$domain"
      nginx -t
      systemctl reload nginx

  - path: /etc/systemd/system/simple-vpn-certificate.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Obtain the Simple VPN site certificate after DNS points here
      After=network-online.target nginx.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/ensure-simple-vpn-certificate

  - path: /etc/systemd/system/simple-vpn-certificate.timer
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Retry the Simple VPN site certificate until DNS is ready

      [Timer]
      OnBootSec=30s
      OnUnitActiveSec=2min
      Unit=simple-vpn-certificate.service

      [Install]
      WantedBy=timers.target

runcmd:
  - [ sh, -c, 'fallocate -l 512M /swapfile && chmod 0600 /swapfile && mkswap /swapfile && swapon /swapfile && echo "/swapfile none swap sw 0 0" >> /etc/fstab' ]
  - [ rm, -f, /etc/nginx/sites-enabled/default ]
  - [ ln, -sfn, /etc/nginx/sites-available/simple-vpn, /etc/nginx/sites-enabled/simple-vpn ]
  - [ nginx, -t ]
  - [ systemctl, enable, --now, nginx ]
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, --now, simple-vpn-certificate.timer ]
  - [ systemctl, try-restart, ssh ]

final_message: "site-1 ready"
